FROM golang:1.24-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY main.go ./
COPY sites.txt ./
COPY proxies.txt ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /app/api .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /app/api ./
COPY --from=builder /app/sites.txt ./
COPY --from=builder /app/proxies.txt ./
ENV PORT=8080
ENV WORKERS=200
EXPOSE 8080
ENTRYPOINT ["/app/api"]
